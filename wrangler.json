{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decant-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "logpush": false,
  "keep_vars": true,
  "triggers": { "crons": ["17 3 * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "DAILY_CAP": "5000", "MAX_RAW_REPORTS": "50000" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "decant-relay",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "decant-relay-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": false },
      "logpush": false,
      "triggers": { "crons": ["17 3 * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "vars": { "DAILY_CAP": "5000", "MAX_RAW_REPORTS": "50000", "DIGEST_LABEL": "staging" },
      "routes": [{ "pattern": "report-staging.decant.link", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "decant-relay-staging",
          "database_id": "785dcfd7-e6bc-48f9-a02e-b89e30bd3d19",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": false },
      "logpush": false,
      "triggers": { "crons": ["17 3 * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "vars": { "DAILY_CAP": "5000", "MAX_RAW_REPORTS": "50000" },
      "routes": [{ "pattern": "report.decant.link", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "decant-relay-production",
          "database_id": "e2885007-d928-458f-89d6-fde79379a3db",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
